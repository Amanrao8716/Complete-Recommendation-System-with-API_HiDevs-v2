# Copy to .env (never commit it). Used by `docker compose` and for local runs:
#   set -a; source .env; set +a; python -m api.app
# Every setting is optional; the values below are the defaults.
DATABASE_URL=sqlite:///recsys.db
API_KEY=
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
LOG_FORMAT=json
CACHE_TTL=300
CACHE_MAX_SIZE=5000
MAX_LIMIT=50
DEFAULT_LIMIT=5
N_NEIGHBORS=10
N_POPULAR=20
DIVERSITY_PENALTY=0.92
PROFICIENCY_GAIN=0.15
MAX_REQUEST_BYTES=16384
METRICS_WINDOW=2000
# STRATEGY_WEIGHTS_FILE=config/strategy_weights.json
